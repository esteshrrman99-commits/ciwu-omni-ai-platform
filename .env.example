# ===========================================
# CIWU OMNI v6.0 - ENVIRONMENT VARIABLES
# Copy this to .env and fill in your keys
# ALSO set these in Render Dashboard → Environment
# ===========================================

# CORE
PORT=10000
NODE_ENV=production
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# AI ENGINE
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY

# PAYMENTS
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_WITH_YOUR_KEY
STRIPE_PRICE_PLUS=price_REPLACE_WITH_STRIPE_PRICE_ID
STRIPE_PRICE_PRO=price_REPLACE_WITH_STRIPE_PRICE_ID

# MEDICAL DATABASES
NCBI_API_KEY=REPLACE_WITH_NCBI_KEY
CLINICAL_TRIALS_API=https://clinicaltrials.gov/api/v2/studies

# DATABASE
MONGODB_URI=mongodb+srv://REPLACE_WITH_MONGODB_ATLAS_URI

# COMMUNICATIONS
SENDGRID_API_KEY=SG.REPLACE_WITH_SENDGRID_KEY
TWILIO_ACCOUNT_SID=AC_REPLACE_WITH_TWILIO_SID
TWILIO_AUTH_TOKEN=REPLACE_WITH_TWILIO_TOKEN
TWILIO_PHONE=+1REPLACE_WITH_TWILIO_NUMBER

# INSURANCE (Optional - Phase 2)
CHANGE_HEALTHCARE_CLIENT_ID=REPLACE
CHANGE_HEALTHCARE_CLIENT_SECRET=REPLACE

# MOBILE
EXPO_PROJECT_ID=REPLACE_WITH_EXPO_PROJECT_ID

# --------------------------------------------------
# Preserved local CIWU environment variable names
# Values intentionally blank — never store secrets here.
# --------------------------------------------------
CIWU_PRODUCT_001_PRICE_ID=
PUBLIC_BASE_URL=
